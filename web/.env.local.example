# Supabase — kopieer naar .env.local en vul in (Settings -> API in je Supabase-project)
NEXT_PUBLIC_SUPABASE_URL=https://JOUW-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=JOUW-ANON-PUBLISHABLE-KEY

# Alleen serverkant (nooit naar de browser). Voor admin-taken/provisioning.
SUPABASE_SERVICE_ROLE_KEY=JOUW-SERVICE-ROLE-KEY

# AI-laag (optioneel). Zonder key blijven handmatige flows werken; AI-knoppen
# (transactie-categorisering, omgevingsfilter, notulen, subsidie-verrijking) zijn dan uit.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Subsidie-ingestie. SERVICE_ROLE_KEY (hierboven) is vereist voor de import-/verrijk-routes.
# SUBSIDIE_IMPORT_SECRET beschermt POST /api/subsidie/import en /verrijk: stuur de
# waarde mee als header `x-import-secret`. Niet gezet -> routes alleen buiten productie.
SUBSIDIE_IMPORT_SECRET=

# KOOP/CVDR-bron (optioneel; defaults werken). De live host is zoekservice; de
# doc-host repository.overheid.nl gebruikt dt.-geprefixte indexen (zet dan KOOP_INDEX_PREFIX=dt.).
KOOP_SRU_BASE=https://zoekservice.overheid.nl/sru/Search
KOOP_INDEX_PREFIX=
KOOP_CAP_PER_CREATOR=300
